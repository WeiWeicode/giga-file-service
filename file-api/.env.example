# 複製為 .env(不進版控,AI 不開啟);部署區差異見 AGENT.md §6、docs/DEPLOYMENT.md §1。缺少必要設定時啟動失敗。
# dev:本機開發(不自動註冊)/ test:測試區 / prod:正式區
GW_ENV=dev
# 服務代碼 = 內部 Token 的 aud(BACKEND-GUIDE §3.3);不可自行更換
SERVICE_CODE=file-api
PORT=51272
# Gateway 位址(JWKS、自動註冊經此)
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# 本機直連時不驗證 X-Internal-Token(只限 dev;非 dev 設定即啟動失敗)
DEV_SKIP_TOKEN=1

# 檔案根目錄(dev 用本機暫存目錄,不要指向 /srv/giga-files 或任何舊來源)
FILE_ROOT=./data/files

# SQL Server 2012:giganexus_gw_test 的 schema file_svc(DATABASE.md §0;db/dba/01-create-schema.sql)
FILE_DB_HOST=10.10.130.220
FILE_DB_PORT=1433
FILE_DB_NAME=giganexus_gw_test
FILE_DB_USER=file_app
FILE_DB_PASSWORD=
# test / prod 只接受 _FILE:FILE_DB_PASSWORD_FILE=/run/secrets/file_db_password
# migration(npm run db:migrate)與整合測試(npm run test:int)用的帳號
FILE_MIGRATE_USER=file_migrate
FILE_MIGRATE_PASSWORD=
# 整合測試專用庫:每次執行會清空 file_svc 的資料表,不可指向上面的庫
FILE_TEST_DB_NAME=giganexus_gw_poc_test

# BPM 附件(F6;API.md §3):NaNa 唯讀帳號(db/dba/02-create-bpm-readonly.sql,只有附件 5 張表 SELECT)
# 測試區 / 開發 → 191;正式區 → 190(帳號同名、密碼不同)
BPM_DB_HOST=10.10.130.191
BPM_DB_PORT=1433
BPM_DB_NAME=NaNa
BPM_DB_USER=file_bpm_ro
BPM_DB_PASSWORD=
# test / prod 只接受 _FILE:BPM_DB_PASSWORD_FILE=/run/secrets/bpm_db_password
# BPM 取檔服務(python_BPM190191檔案下載API,FastAPI :5144):測試區 191、正式區 190;金鑰只放 file-api
BPM_FILE_URL=http://10.10.130.191:5144
BPM_FILE_API_KEY=
# test / prod 只接受 _FILE:BPM_FILE_API_KEY_FILE=/run/secrets/bpm_file_api_key

# 舊來源(唯讀盤點 npm run inventory;預設即為下列 UNC 路徑)
# LEGACY_NAS_ROOT=\\10.10.130.31\docker-folder
# LEGACY_PORTAL_ROOT=\\10.10.130.166\PortalSolar

# 允許的副檔名(逗號分隔;未設定用 file-types.ts 的暫定清單,PRD §11 #6 待定)
# FILE_ALLOWED_EXTS=pdf,png,jpg,xlsx
# 未綁定暫存檔保留時數(預設 24)
# TEMP_RETENTION_HOURS=24
# 監控(giga-observe):dev 預設關閉
# MONITOR_ENABLED=true
# MONITOR_URL=
# MONITOR_API_KEY=
