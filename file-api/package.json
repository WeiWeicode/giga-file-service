{
  "name": "@giganexus/file-api",
  "version": "0.1.0",
  "private": true,
  "description": "GigaNexus 附件服務 file-api(Node.js + Fastify):UUID 上傳 / 下載 / 綁定 / 軟刪除、WSL 存放;舊系統唯讀盤點(docs/PRD.md)",
  "type": "module",
  "gateway": {
    "project": "giga-file-service"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:int": "tsx --env-file-if-exists=.env --test test/int/*.int.test.ts",
    "test:legacy": "tsx --env-file-if-exists=.env --test test/legacy/*.legacy.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "db:check-2012": "tsx scripts/check-sql2012.ts",
    "openapi": "tsx src/print-openapi.ts",
    "inventory": "tsx --env-file-if-exists=.env src/cli/inventory.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fastify/multipart": "10.1.2",
    "@fastify/swagger": "9.9.1",
    "@giganexus/backend-sdk": "^0.3.0",
    "drizzle-orm": "1.0.0-rc.4",
    "fastify": "5.12.5",
    "mssql": "11.0.2"
  },
  "devDependencies": {
    "@types/mssql": "9.1.11",
    "@types/node": "22.20.4",
    "drizzle-kit": "1.0.0-rc.4",
    "jose": "6.2.12",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
